{
  "manifest_version": 3,
  "name": "Media Control",
  "version": "1.0.9",
  "description": "Chrome-style media controls for every tab playing audio or video.",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-control@personal.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "webNavigation", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/app.svg",
    "96": "icons/app.svg"
  },
  "action": {
    "default_title": "Media Control",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/note-white.svg",
    "theme_icons": [
      { "light": "icons/note-white.svg", "dark": "icons/note-dark.svg", "size": 16 },
      { "light": "icons/note-white.svg", "dark": "icons/note-dark.svg", "size": 32 }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
